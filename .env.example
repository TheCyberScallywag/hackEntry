# Copy to .env (never committed). Everything here is optional for the local demo.
# ORG_NAMES={"datakind-uk": "Organisation A", "cyber-scallywags": "Organisation B"}
# Optional AuraDB dev instance for `python -m app.cli aura-push` / `aura-parity`:
AURA_URI=
AURA_USERNAME=neo4j
AURA_PASSWORD=
AURA_DATABASE=neo4j

# Cloudflare Tunnel token for `docker compose --profile tunnel up -d` (Zero Trust > Networks >
# Tunnels). It is a credential: keep it in .env only.
CLOUDFLARE_TUNNEL_TOKEN=

# The assistants (Pydantic AI agents in src/app/agents). Leave AGENT_MODEL empty and they are
# switched off: their endpoints answer 503 and nothing else changes.
AGENT_MODEL=
# AGENT_MODEL=anthropic:claude-sonnet-5-5
AGENT_FALLBACK_MODEL=
ANTHROPIC_API_KEY=
# Limits: per run (requests, tool calls, tokens, seconds) and per account per day.
# AGENT_REQUEST_LIMIT=8
# AGENT_TOOL_CALLS_LIMIT=16
# AGENT_TOTAL_TOKENS_LIMIT=40000
# AGENT_TIMEOUT_SECONDS=90
# AGENT_DAILY_RUNS=40

# Pydantic Logfire write token. Empty: traces and evaluation results are made but sent nowhere.
LOGFIRE_TOKEN=
# Prompts, tool arguments and model output on agent spans: on by default, off in production.
# LOGFIRE_INCLUDE_CONTENT=false
# AUDIT_RETENTION_DAYS=400

# Onboarding emails (each organisation's workflow, edited in the admin console). They are queued
# in SQLite and sent over SMTP. Empty SMTP_HOST: nothing is sent and queued messages are marked
# "not configured". Docker Compose defaults SMTP_HOST to its `mail` sidecar (Mailpit, inbox at
# http://localhost:8025), which catches everything and delivers nothing.
# For `uv run task web`, run a catcher yourself: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
SMTP_HOST=
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# EMAIL_FROM=volunteers@example.org
# Set to false to stop new accounts being created (web and API). Existing accounts still sign in.
# SIGNUP_ENABLED=true
# Where volunteers reach the web app: the links in emails start with it.
# PUBLIC_URL=http://localhost:8080
